# Password unica dell'ufficio (obbligatoria: senza, l'accesso resta chiuso)
UFFICIO_PASSWORD=
# Database: ruolo dedicato mensa_app sullo schema mensa del Postgres self-hosted del Comune
MENSA_DATABASE_URL=postgres://mensa_app:PASSWORD@192.168.1.40:5432/postgres
# "require" solo se il database è raggiunto da una rete non fidata (in LAN lasciare vuoto)
MENSA_DATABASE_SSL=
# Connessioni massime del pool (predefinito 5)
MENSA_DATABASE_POOL=5
# Solo per le migrazioni (utente amministratore) e per impostare la password di mensa_app
MENSA_DATABASE_ADMIN_URL=
MENSA_APP_DB_PASSWORD=
